{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "yen-blocks/list-item",
    "version": "1.0.0",
    "title": "List Item",
    "category": "yen-blocks",
    "parent": ["yen-blocks/list"],
    "description": "Individual item within a list block.",
    "example": {},
